# --- LLM provider: "gemini" (free key at https://aistudio.google.com/apikey) or "claude" ---
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude needs an API key from https://console.anthropic.com (a Claude.ai subscription is NOT an API key)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Research sources ---
# Kaggle: kaggle.com -> Settings -> API -> "Generate New Token" (KGAT_... token)
KAGGLE_API_TOKEN=
# legacy alternative: username + key (or ~/.kaggle/kaggle.json)
KAGGLE_USERNAME=
KAGGLE_KEY=
# Optional: Semantic Scholar key (works without, but rate-limited) https://www.semanticscholar.org/product/api
S2_API_KEY=
# Optional: Hugging Face token (public search works without)
HF_TOKEN=
